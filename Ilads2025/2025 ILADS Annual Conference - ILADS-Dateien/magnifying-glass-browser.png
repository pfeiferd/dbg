.notice-practice{
	    position: fixed;
    top: 0;
	bottom: 0;
    width: 100%;
	height: 150px;
    max-width: 400px;
    right: 20%;
    margin: auto;
    background: #ffbaba;
    z-index: 9999;
    border: 2px solid #f40000;
    padding: 20px;
    text-align: center;
    font-size: 15px;
    border-radius: 5px;
	opacity: 0;
	transition: all .2s ease;
	font-weight: 600;
}

.notice-practice.visible{
	opacity: 1 !important;
}

#hero-banner{
	position: relative;
}

#hero-banner:before{
	content: '';
	display: block;
	
	width: 300px;
	height: 500px;
	
	left: -2%;
	bottom: -20%;
	
	position: absolute;
	
	background-image: url('https://www.ilads.org/wp-content/uploads/2021/12/Layer-15@1X2.png');
	background-repeat: no-repeat;
	background-position: left bottom;
	
	background-size: contain;
	
	z-index: 999;
	
	opacity: 0.06;
}

#middle-section{
	z-index: 999999999;
	position: relative;
}

.left-ilads img{
	z-index: 9999999;
	position: relative;
}

.left-ilads, .right-ilads{
	position: relative;
}

.right-ilads .fl-col-content{
	position: relative;
	z-index: 999999;
}

.left-ilads:before{
	content: '';
	display: block;
	
	width: 300px;
	height: 500px;
	
	left: -5%;
	
	position: absolute;
	
	background-image: url('https://www.ilads.org/wp-content/uploads/2021/12/Layer-15@1X2.png');
	background-repeat: no-repeat;
	background-position: left bottom;
	
	background-size: contain;
	
	z-index: 999;
	
	opacity: 0.06;
}

.right-ilads:before{
	content: '';
	display: block;
	
	width: 300px;
	height: 500px;
	
	right: -5%;
	bottom: 15%;
	
	position: absolute;
	
	background-image: url('https://www.ilads.org/wp-content/uploads/2021/12/Layer-15@1X2.png');
	background-repeat: no-repeat;
	background-position: left bottom;
	
	background-size: contain;
	
	z-index: 999;
	
	opacity: 0.06;
	
	-moz-transform: scale(-1, 1);
    -o-transform: scale(-1, 1);
    -webkit-transform: scale(-1, 1);
    transform: scale(-1, 1);
}

