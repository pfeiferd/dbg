	margin-left: 0;
	margin-right: 0;
}

body.blog .fl-post-image-beside{
	width: 200px;
}

/* Fix Table Font */
table.tg th,
table.tg td {
	font-family: "Raleway",sans-serif !important;
}

/*Fellowship Application Table*/
.fellowship-table thead{
	background: #0c3464;
}

.fellowship-table thead th{
	color: #fff;
	padding: 8px 10px;
}

.fellowship-table tbody td{
	padding: 8px 10px;
}

.fellowship-table tbody tr:nth-child(odd){
	background: #ededed;
}

/*Remove pseudo elements from speakers*/
.row.speakers:before,
.row.speakers:after{
	display: none;	
}

.post-presenters .speaker-image,
.post-presenters .speaker-title{
	pointer-events: none;
}

/*Fix callout vertical alignment*/
.page-id-7008 .fl-callout-photo-left .fl-callout-photo{
	vertical-align: middle;
}		</style>
