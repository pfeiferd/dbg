	isbn = {1750-2799},
	journal = {Nature Protocols},
	number = {12},
	pages = {2815--2839},
	title = {Metagenome analysis using the Kraken software suite},
	url = {https://doi.org/10.1038/s41596-022-00738-y},
	volume = {17},
	year = {2022},
